{"op": "slice", "title": "Estimated games by year", "sql": "SELECT t.year, SUM(f.sample_weight) AS est_games\nFROM game_fact f JOIN dim_time t USING(time_key)\nGROUP BY ROLLUP(t.year);", "columns": [{"key": "year", "label": "Year", "type": "text"}, {"key": "est_games", "label": "Est. games", "type": "integer"}, {"key": "n", "label": "Sample n", "type": "integer"}], "rows": [{"year": "2013", "est_games": 3300000, "n": 9000}, {"year": "2014", "est_games": 11300000, "n": 22}, {"year": "2015", "est_games": 29200000, "n": 60000}, {"year": "Total", "est_games": 43800000, "n": 69022, "is_total": true}], "chart": {"type": "bar", "x": "year", "series": ["est_games"]}, "elapsed_ms": 142, "note": "Counts are weighted estimates (SUM of sample_weight)."}